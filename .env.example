# Shared runtime mode: development, test, or production.
NODE_ENV=development

# API listener. Keep PORT numeric and within the TCP port range.
HOST=127.0.0.1
PORT=3000

# Trusted Supabase Auth token metadata. The API verifies tokens through public
# JWKS; it does not need an anon, publishable, secret, or service-role key.
AUTH_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
AUTH_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
AUTH_JWT_AUDIENCE=authenticated
AUTH_PROVIDER=supabase

# Comma-separated exact browser origins. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
REQUEST_BODY_LIMIT_BYTES=32768

# Phase 3 uses a per-process, per-IP limiter for the bootstrap endpoint.
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20

# Worker lifecycle only; no jobs are implemented in Phase 1.
WORKER_POLL_INTERVAL_MS=1000

# Variables prefixed with VITE_ are public and must never contain secrets.
VITE_API_BASE_URL=http://localhost:3000
VITE_APP_ENV=development

# Local Supabase PostgreSQL. The application URL assumes the restricted role
# created by the foundational migration. These credentials are local-only.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?options=-c%20role%3Dcreatordrop_app
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_APPLICATION_NAME=creatordrop-local
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=5000
