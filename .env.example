# Shared runtime mode: development, test, or production.
NODE_ENV=development

# API listener. Keep PORT numeric and within the TCP port range.
HOST=127.0.0.1
PORT=3000

# Worker lifecycle only; no jobs are implemented in Phase 1.
WORKER_POLL_INTERVAL_MS=1000

# Variables prefixed with VITE_ are public and must never contain secrets.
VITE_API_BASE_URL=http://localhost:3000
VITE_APP_ENV=development
